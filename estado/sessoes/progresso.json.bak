  "ideias": [
    {
      "hora": "2026-10-17T18:12:18",
      "texto": "trocar o fusível do processador de 5 A (provisório) por 1–2 A"
    },
    {
      "hora": "2026-10-17T18:17:51",
      "texto": "medir a Fb do duto (varredura 25–60 Hz) e soltar o subsônico"
    },
    {
      "hora": "2026-10-17T18:21:10",
      "texto": "medir a Fb do duto (varredura 25–60 Hz) e soltar o subsônico"
    },
    {
      "hora": "2026-10-17T18:47:43",
      "texto": "automação: ligar o remote out (252, liga o módulo) e o gerador (200–202) pelo notebook, com trava própria no guardião e teste; hoje a regra 5 recusa de propósito"
    },
    {
      "hora": "2026-10-17T19:33:00",
      "texto": "filme por BT: testar o atraso no streaming; comprar cabo P2 macho → 2 RCA (o Y de 1 RCA fêmea → 2 RCA macho que existe não serve)"
    },
    {
      "hora": "2026-10-17T19:50:32",
      "texto": "auditoria 19:29 (MÉDIO): confirmar o teto do sub em ponte medindo com o limiter do sub em −9 dB (≈18 V = 23,4 era o teto); subir o f_min do sub no guardião para 40 Hz até medir a Fb"
    },
    {
      "hora": "2026-10-17T20:29:56",
      "texto": "MUSICA HIGH mais alta: com auditoria nova, avaliar se o ganho das JBL a −9,0 (pico medido 11,6 V, abaixo dos 12,6 V da ficha com LR24 150 Hz) pode valer; ganho esperado: +2 dB na média (nítido), +0,5 dB no pico"
    },
    {
      "hora": "2026-10-19T22:11:44",
      "texto": "Refazer a MUSICA ORIG (Memória 2): ainda é a versão antiga, com o limitador do sub em -6 dB (passa 40 V). Base: HIGH + atrasos da FILME + EQ do dia a dia."
    },
    {
      "hora": "2026-10-19T22:11:44",
      "texto": "Presets DIALOGO e NOITE do celular foram salvos antes dos atrasos e da compressão: refazer a partir da FILME definitiva ou apagar."
    },
    {
      "hora": "2026-10-19T22:11:44",
      "texto": "Físico, grátis: virar as JBL para o ouvinte (toe-in), levantar à altura do ouvido, sentar entre elas (hoje 0,9 m à direita da R); tapete. Depois recalcular atrasos e níveis."
    },
    {
      "hora": "2026-10-19T22:11:45",
      "texto": "Tweeter da JBL esquerda mais fraco (acompanha a caixa): abrir, conferir fibra e tweeter/capacitor. Sem EQ de compensação até lá."
    },
    {
      "hora": "2026-10-19T22:11:45",
      "texto": "UMIK-1 + REW: medir a sala e a Fb do duto do sub; só então descer o subsônico de 40 Hz (o guardião barrou 35 Hz)."
    },
    {
      "hora": "2026-10-19T22:11:45",
      "texto": "Fonte melhor que o BT do celular: TV box Android 14 + extrator HDMI->RCA (sem SBC, 5.1 com modo noturno); exige recalibrar o ganho (cabo ~13 dB mais forte)."
    }
  ]
}
