<?xml version="1.0" encoding="utf-8" ?>
<!--
    Configurações › Memórias (EXPERIENCE, Cartão de memória; DESIGN, cartao-de-memoria): as memórias do celular
    do Setup em uso (EM USO, HERDADO, o preset lembrado; Aplicar, Renomear, Apagar), Criar memória do som atual e,
    junto dele, o chip "+ Nova memória" (história 10d; até a Roda existir): pede a criação com perguntas, que
    sobe em tela toda quando abre. Travado (sem Setup, na dúvida, só leitura ou com uma criação aberta), apagado e
    com o motivo. O aviso rápido da casca ("Memória MUSICA ORIG criada no Casa 2.1.") aparece aqui também.
    As memórias do processador não aparecem (decisão do Denis, 29/10/2026).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telas="clr-namespace:BgsControle.Telas;assembly=BgsControle.Telas"
             xmlns:c="clr-namespace:BgsControle.App.Controles"
             x:Class="BgsControle.App.Telas.MemoriasPage"
             x:DataType="telas:MemoriasViewModel"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="16,8">
                <Button Style="{StaticResource botao-voltar}" Clicked="AoVoltar" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Style="{StaticResource tipo-titulo-tela}" Text="Memórias" />
                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding TituloCelular}" />
                </VerticalStackLayout>
            </Grid>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16,8" Spacing="10">
                    <Label Style="{StaticResource tipo-detalhe}" TextColor="{StaticResource texto}" Text="{Binding Mensagem}"
                           IsVisible="{Binding Mensagem, Converter={StaticResource TemTexto}}" />
                    <Label Style="{StaticResource tipo-apoio}" Text="{Binding MotivoTravaCelular}"
                           IsVisible="{Binding MotivoTravaCelular, Converter={StaticResource TemTexto}}" />

                    <!-- Som diferente da memória ativa. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                          IsVisible="{Binding AvisoSomDiferente, Converter={StaticResource TemTexto}}">
                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource apoio}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Style="{StaticResource tipo-detalhe}" TextColor="{StaticResource texto}"
                               Text="{Binding AvisoSomDiferente}" VerticalTextAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource botao-pequeno}" Text="Reaplicar" Command="{Binding Reaplicar}" />
                    </Grid>

                    <!-- As memórias do celular. -->
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Cartoes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="telas:CartaoMemoriaCelularViewModel">
                                <Border Style="{StaticResource cartao-grande}">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Border IsVisible="{Binding EmUso}" BackgroundColor="{StaticResource texto}" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 11" HeightRequest="22" Padding="8,0">
                                                <Label Style="{StaticResource tipo-rotulo}" TextColor="{StaticResource sobre-escolhido}"
                                                       Text="{Binding SeloEmUso}" VerticalTextAlignment="Center" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Style="{StaticResource tipo-memoria-lista}" Text="{Binding Nome}" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="{Binding TextoPreset}"
                                               IsVisible="{Binding TextoPreset, Converter={StaticResource TemTexto}}" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <Button Style="{StaticResource botao-pequeno}" Text="Aplicar" Command="{Binding Aplicar}" />
                                            <Button Grid.Column="1" Style="{StaticResource botao-contornado-pequeno}" Text="Renomear" Command="{Binding Renomear}" />
                                            <Button Grid.Column="2" Style="{StaticResource botao-contornado-pequeno}" Text="Apagar" Command="{Binding Apagar}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding EmUso}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource apagado}" />
                                                        <Setter Property="BorderColor" Value="Transparent" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Style="{StaticResource tipo-apoio}" Text="{Binding TextoVazio}"
                           IsVisible="{Binding TextoVazio, Converter={StaticResource TemTexto}}" />
                    <Button Style="{StaticResource botao-secundario}" Text="{x:Static telas:MemoriasViewModel.TextoCriar}"
                            Command="{Binding AbrirCriar}" />
                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaCriar}"
                           IsVisible="{Binding MotivoTravaCriar, Converter={StaticResource TemTexto}}" />
                    <!-- + Nova memória (história 10d): o pedido vai à porta; a criação aparece quando abre. -->
                    <Button Style="{StaticResource chip-bgs}" HorizontalOptions="Start" Margin="0,6,0,0"
                            Text="{x:Static telas:MemoriasViewModel.TextoNovaMemoria}" Command="{Binding NovaMemoria}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding PodeNovaMemoria}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaNovaMemoria}"
                           IsVisible="{Binding MotivoTravaNovaMemoria, Converter={StaticResource TemTexto}}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Criar memória do som atual: o nome. -->
        <c:FolhaView Aberta="{Binding CriarAberto}" Fechar="{Binding CancelarCriar}">
            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource tipo-titulo-folha}" Text="{x:Static telas:MemoriasViewModel.TextoCriar}" />
                <Label Style="{StaticResource tipo-corpo}" TextColor="{StaticResource apoio}"
                       Text="A memória nova guarda o caráter que está tocando e vira a memória em uso." />
                <Entry Style="{StaticResource entrada}" Text="{Binding NomeNova}" MaxLength="24" Placeholder="MUSICA ORIG"
                       ReturnType="Done" ReturnCommand="{Binding ConfirmarCriar}" />
                <Label Style="{StaticResource tipo-texto-erro}" Text="{Binding ErroNova}"
                       IsVisible="{Binding ErroNova, Converter={StaticResource TemTexto}}" />
                <Button Style="{StaticResource botao-principal}" Text="Criar a memória" Command="{Binding ConfirmarCriar}" />
                <Button Style="{StaticResource botao-secundario}" Text="Cancelar" Command="{Binding CancelarCriar}" />
            </VerticalStackLayout>
        </c:FolhaView>

        <!-- Renomear. -->
        <c:FolhaView Aberta="{Binding RenomearAberto}" Fechar="{Binding CancelarRenomear}">
            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource tipo-titulo-folha}" Text="{Binding RenomearTitulo}" />
                <Entry Style="{StaticResource entrada}" Text="{Binding NomeRenomear}" MaxLength="24"
                       ReturnType="Done" ReturnCommand="{Binding ConfirmarRenomear}" />
                <Label Style="{StaticResource tipo-texto-erro}" Text="{Binding ErroRenomear}"
                       IsVisible="{Binding ErroRenomear, Converter={StaticResource TemTexto}}" />
                <Button Style="{StaticResource botao-principal}" Text="Renomear" Command="{Binding ConfirmarRenomear}" />
                <Button Style="{StaticResource botao-secundario}" Text="Cancelar" Command="{Binding CancelarRenomear}" />
            </VerticalStackLayout>
        </c:FolhaView>

        <!-- Apagar. -->
        <c:FolhaView Aberta="{Binding ApagarAberto}" Fechar="{Binding CancelarApagar}">
            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource tipo-titulo-folha}" Text="{Binding ApagarTitulo}" />
                <Label Style="{StaticResource tipo-corpo}" Text="{Binding ApagarAviso}" />
                <Button Style="{StaticResource botao-principal}" Text="Apagar a memória" Command="{Binding ConfirmarApagar}" />
                <Button Style="{StaticResource botao-secundario}" Text="Cancelar" Command="{Binding CancelarApagar}" />
            </VerticalStackLayout>
        </c:FolhaView>

        <!-- A folha do Salvar (Criar memória com o som do aparelho em uso). -->
        <c:SalvarFolhaView x:Name="FolhaSalvar" />

        <!-- O aviso rápido da casca (2,6 s), ao fechar a criação. -->
        <c:AvisoRapidoView x:Name="AvisoRapido" Anunciar="False" />
    </Grid>
</ContentPage>
