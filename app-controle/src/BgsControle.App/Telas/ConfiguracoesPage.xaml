<?xml version="1.0" encoding="utf-8" ?>
<!--
    Configurações (a engrenagem; DESIGN, linha-de-configuracao, linha-de-chave, avancado; EXPERIENCE, Linha de
    configuração): SOM (Setups, Memórias, Presets), APARELHO (remote out e Bluetooth de áudio no par de botões
    da própria linha, com o valor relido do aparelho; o nome do produto que vale no ✓; Senha ›; Voltímetro e
    clip ›; a chave "Controle pela rede", com o código de pareamento embaixo dela), ACESSO (Chaves de acesso) e o
    Avançado recolhido com o reset de áudio e o reset de fábrica (travados com a chave desligada; com ela, a folha
    do risco). Travado diz por quê. Nenhuma linha mostra a IA (decisão do Denis, 30/10/2026).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telas="clr-namespace:BgsControle.Telas;assembly=BgsControle.Telas"
             xmlns:c="clr-namespace:BgsControle.App.Controles"
             x:Class="BgsControle.App.Telas.ConfiguracoesPage"
             x:DataType="telas:ConfiguracoesViewModel"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <Style x:Key="linha" TargetType="Grid">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="ColumnSpacing" Value="10" />
        </Style>
        <Style x:Key="seta" TargetType="Label">
            <Setter Property="Text" Value="›" />
            <Setter Property="TextColor" Value="{StaticResource apagado}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="par" TargetType="Button" BasedOn="{StaticResource botao-contornado-pequeno}">
            <Setter Property="BorderColor" Value="{StaticResource sup-2}" />
            <Setter Property="WidthRequest" Value="56" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>
    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="16,8">
                <Button Style="{StaticResource botao-voltar}" Command="{Binding Voltar}" />
                <Label Grid.Column="1" Style="{StaticResource tipo-titulo-tela}" Text="Configurações" VerticalTextAlignment="Center" />
            </Grid>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16,8,16,24" Spacing="8">

                    <!-- SOM -->
                    <Label Style="{StaticResource tipo-rotulo}" Text="SOM" />
                    <Border Style="{StaticResource cartao}" Padding="0">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding TituloSetups}" />
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding DescricaoSetups}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Style="{StaticResource seta}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirSetups}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource sup-3}" />
                            <Grid Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding TituloMemorias}" />
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding DescricaoMemorias}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Style="{StaticResource seta}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirMemorias}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource sup-3}" />
                            <Grid Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding TituloPresets}" />
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding DescricaoPresets}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Style="{StaticResource seta}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirPresets}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- APARELHO -->
                    <Label Style="{StaticResource tipo-rotulo}" Text="APARELHO" Margin="0,8,0,0" />
                    <ContentView BindingContext="{Binding Aparelho}">
                        <Label x:DataType="telas:AparelhoViewModel" Style="{StaticResource tipo-detalhe}"
                               TextColor="{StaticResource texto}" Text="{Binding Mensagem}"
                               IsVisible="{Binding Mensagem, Converter={StaticResource TemTexto}}" />
                    </ContentView>
                    <Border Style="{StaticResource cartao}" Padding="0">
                        <VerticalStackLayout>
                            <VerticalStackLayout BindingContext="{Binding Aparelho}">
                                <!-- Remote out: liga na própria linha, sem folha; o valor é o relido. -->
                                <Grid x:DataType="telas:AparelhoViewModel" Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Style="{StaticResource tipo-linha-titulo}" Text="Remote out" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="Liga e desliga o módulo" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaRemoteOut}"
                                               IsVisible="{Binding MotivoTravaRemoteOut, Converter={StaticResource TemTexto}}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center"
                                                           SemanticProperties.Description="{Binding TextoRemoteOut}">
                                        <Button Style="{StaticResource par}" Text="Desl." Command="{Binding DesligarRemoteOut}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding RemoteOutLigado}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource texto}" />
                                                    <Setter Property="TextColor" Value="{StaticResource sobre-escolhido}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Style="{StaticResource par}" Text="Lig." Command="{Binding LigarRemoteOut}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding RemoteOutLigado}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource texto}" />
                                                    <Setter Property="TextColor" Value="{StaticResource sobre-escolhido}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource sup-3}" />
                                <!-- Bluetooth de áudio. -->
                                <Grid x:DataType="telas:AparelhoViewModel" Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Style="{StaticResource tipo-linha-titulo}" Text="Bluetooth de áudio" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="A música do Player chega por ele" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaBluetoothAudio}"
                                               IsVisible="{Binding MotivoTravaBluetoothAudio, Converter={StaticResource TemTexto}}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center"
                                                           SemanticProperties.Description="{Binding TextoBluetoothAudio}">
                                        <Button Style="{StaticResource par}" Text="Desl." Command="{Binding DesligarBluetoothAudio}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding BluetoothAudioLigado}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource texto}" />
                                                    <Setter Property="TextColor" Value="{StaticResource sobre-escolhido}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Style="{StaticResource par}" Text="Lig." Command="{Binding LigarBluetoothAudio}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding BluetoothAudioLigado}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource texto}" />
                                                    <Setter Property="TextColor" Value="{StaticResource sobre-escolhido}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource sup-3}" />
                                <!-- O nome do produto: vale no ✓, relê depois. -->
                                <Grid x:DataType="telas:AparelhoViewModel" Style="{StaticResource linha}" ColumnDefinitions="*,150,Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Style="{StaticResource tipo-linha-titulo}" Text="Nome do produto" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="Até 12 caracteres" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaNome}"
                                               IsVisible="{Binding MotivoTravaNome, Converter={StaticResource TemTexto}}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Style="{StaticResource campo-numerico}" MinimumWidthRequest="0" VerticalOptions="Center">
                                        <Grid>
                                            <Entry x:Name="CampoNome" Style="{StaticResource entrada}" BackgroundColor="Transparent" MaxLength="12"
                                                   Text="{Binding NomeProduto}" ReturnType="Done" ReturnCommand="{Binding ConfirmarNome}" />
                                            <BoxView HeightRequest="2" VerticalOptions="End" Margin="-10,0" Color="{StaticResource texto}" />
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource botao-pequeno}" Text="✓" WidthRequest="44" Padding="0"
                                            VerticalOptions="Center" Command="{Binding ConfirmarNome}" SemanticProperties.Description="Gravar o nome" />
                                </Grid>
                                <Label x:DataType="telas:AparelhoViewModel" Style="{StaticResource tipo-texto-erro}" Margin="16,0,16,8"
                                       Text="{Binding ErroNome}" IsVisible="{Binding ErroNome, Converter={StaticResource TemTexto}}" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="{StaticResource sup-3}" />
                            <!-- A chave "Controle pela rede" (a mesma linha das Chaves de acesso; ligar abre a folha do risco)
                                 e, com ela ligada, o código de 6 dígitos ou o cliente pareado, o endereço e o erro. -->
                            <VerticalStackLayout BindingContext="{Binding ControlePelaRede}">
                              <VerticalStackLayout x:DataType="telas:ControlePelaRedeViewModel">
                                <Grid BindingContext="{Binding Linha}">
                                    <Grid x:DataType="telas:ItemChaveViewModel" Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                            <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding Nome}" />
                                            <Label Style="{StaticResource tipo-risco-chave}" TextColor="{StaticResource erro-texto}" Text="{Binding Risco}"
                                                   IsVisible="{Binding Risco, Converter={StaticResource TemTexto}}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" SemanticProperties.Description="{Binding TextoEstado}">
                                            <Button Style="{StaticResource par}" Text="Desl." Command="{Binding Desligar}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Ligada}" Value="False">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource texto}" />
                                                        <Setter Property="TextColor" Value="{StaticResource sobre-escolhido}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Button Style="{StaticResource par}" Text="Lig." Command="{Binding Ligar}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Ligada}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource texto}" />
                                                        <Setter Property="TextColor" Value="{StaticResource sobre-escolhido}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                                <!-- O aviso da chave (falha ao guardar, por exemplo), como na tela Chaves de acesso. -->
                                <Label Style="{StaticResource tipo-texto-erro}" Margin="16,0,16,8" Text="{Binding Chaves.Mensagem}"
                                       IsVisible="{Binding Chaves.Mensagem, Converter={StaticResource TemTexto}}" />
                                <VerticalStackLayout x:DataType="telas:ControlePelaRedeViewModel" IsVisible="{Binding Ligada}"
                                                     Padding="16,0,16,12" Spacing="4">
                                    <VerticalStackLayout Spacing="2" IsVisible="{Binding Codigo, Converter={StaticResource TemTexto}}">
                                        <Label Style="{StaticResource tipo-detalhe}" Text="{x:Static telas:ControlePelaRedeViewModel.TextoCodigo}" />
                                        <Label Style="{StaticResource tipo-estado-hero}" Text="{Binding Codigo}" CharacterSpacing="6" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2" IsVisible="{Binding Pareado}">
                                        <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding Cliente}" />
                                        <Label Style="{StaticResource tipo-detalhe}" Text="{Binding PareadoEm, StringFormat='Pareado em {0}'}" />
                                    </VerticalStackLayout>
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding Endereco, StringFormat='Endereço: {0}'}"
                                           IsVisible="{Binding Endereco, Converter={StaticResource TemTexto}}" />
                                    <Label Style="{StaticResource tipo-texto-erro}" Text="{Binding Erro}"
                                           IsVisible="{Binding Erro, Converter={StaticResource TemTexto}}" />
                                </VerticalStackLayout>
                              </VerticalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="{StaticResource sup-3}" />
                            <Grid Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding TituloSenha}" />
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding DescricaoSenha}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Style="{StaticResource seta}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirSenha}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource sup-3}" />
                            <Grid Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding TituloMonitoracao}" />
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding DescricaoMonitoracao}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Style="{StaticResource seta}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirMonitoracao}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ACESSO -->
                    <Label Style="{StaticResource tipo-rotulo}" Text="ACESSO" Margin="0,8,0,0" />
                    <Border Style="{StaticResource cartao}" Padding="0">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource linha}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding TituloChaves}" />
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding DescricaoChaves}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Style="{StaticResource seta}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirChaves}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- AVANÇADO: os resets, recolhidos. -->
                    <Border Margin="0,8,0,0" BackgroundColor="{StaticResource sup-1}" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                            Padding="16,6">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding AvancadoAberto}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource lista-aberta}" />
                                <Setter Property="Stroke" Value="{StaticResource campo-borda}" />
                                <Setter Property="StrokeThickness" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource tipo-rotulo}" Text="AVANÇADO" />
                                    <Label Style="{StaticResource tipo-detalhe}" Text="Reset de áudio, reset de fábrica" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding SetaAvancado}" FontSize="20" TextColor="{StaticResource apoio}"
                                       VerticalTextAlignment="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AlternarAvancado}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding AvancadoAberto}" Spacing="10" Padding="0,0,0,10">
                                <VerticalStackLayout BindingContext="{Binding Aparelho}" Spacing="10">
                                    <Grid x:DataType="telas:AparelhoViewModel" ColumnDefinitions="*,Auto" ColumnSpacing="10" MinimumHeightRequest="52">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Style="{StaticResource tipo-linha-titulo}" Text="Reset de áudio" />
                                            <Label Style="{StaticResource tipo-risco-chave}" TextColor="{StaticResource erro-texto}"
                                                   Text="O estado resultante é imprevisível." />
                                            <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaResetAudio}"
                                                   IsVisible="{Binding MotivoTravaResetAudio, Converter={StaticResource TemTexto}}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Style="{StaticResource botao-pequeno}" Text="Resetar" VerticalOptions="Center"
                                                Command="{Binding ResetAudio}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding PodeResetAudio}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                    <Setter Property="TextColor" Value="{StaticResource apagado}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                    <Grid x:DataType="telas:AparelhoViewModel" ColumnDefinitions="*,Auto" ColumnSpacing="10" MinimumHeightRequest="52">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Style="{StaticResource tipo-linha-titulo}" Text="Reset de fábrica" />
                                            <Label Style="{StaticResource tipo-risco-chave}" TextColor="{StaticResource erro-texto}"
                                                   Text="Apaga a senha e as 3 memórias." />
                                            <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaResetFabrica}"
                                                   IsVisible="{Binding MotivoTravaResetFabrica, Converter={StaticResource TemTexto}}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Style="{StaticResource botao-pequeno}" Text="Resetar" VerticalOptions="Center"
                                                Command="{Binding ResetFabrica}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding PodeResetFabrica}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                    <Setter Property="TextColor" Value="{StaticResource apagado}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- A folha do risco dos resets. -->
        <c:FolhaView x:Name="FolhaAparelho" x:DataType="telas:AparelhoViewModel" Aberta="{Binding FolhaAberta}" Fechar="{Binding CancelarFolha}">
            <c:FolhaAparelhoView />
        </c:FolhaView>

        <!-- A folha do risco ao ligar a chave "Controle pela rede" (a mesma da tela Chaves de acesso). -->
        <c:FolhaView x:Name="FolhaChave" x:DataType="telas:ChavesViewModel" Aberta="{Binding FolhaAberta}" Fechar="{Binding DesistirFolha}">
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource tipo-titulo-folha}" Text="{Binding FolhaTitulo}" />
                <Border BackgroundColor="{StaticResource risco-fundo}" Stroke="{StaticResource risco-borda}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14,10">
                    <Label Style="{StaticResource tipo-texto-risco}" Text="{Binding FolhaRisco}" />
                </Border>
                <Button Style="{StaticResource botao-principal}" Text="{x:Static telas:ChavesViewModel.TextoConfirmar}"
                        Command="{Binding ConfirmarFolha}" />
                <Button Style="{StaticResource botao-secundario}" Text="{x:Static telas:ChavesViewModel.TextoDesistir}"
                        Command="{Binding DesistirFolha}" />
            </VerticalStackLayout>
        </c:FolhaView>
    </Grid>
</ContentPage>
