<?xml version="1.0" encoding="utf-8" ?>
<!--
    Configurações › Histórico (EXPERIENCE, Registro; State Patterns › Histórico vazio; DESIGN, registro): cada
    comando que chegou à porta, da tela, da IA e do app, com a hora, a origem, a frase com o valor e, nas recusas,
    o motivo. A mais nova em cima. Vazio: "Nenhum comando ainda."
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telas="clr-namespace:BgsControle.Telas;assembly=BgsControle.Telas"
             x:Class="BgsControle.App.Telas.HistoricoPage"
             x:DataType="telas:HistoricoViewModel"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="16,8">
            <Button Style="{StaticResource botao-voltar}" Clicked="AoVoltar" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource tipo-titulo-tela}" Text="Histórico" />
                <Label Style="{StaticResource tipo-detalhe}" Text="Origem, hora e valor de cada comando" />
            </VerticalStackLayout>
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="16,8">
            <Label Style="{StaticResource tipo-apoio}" Text="{Binding TextoVazio}"
                   IsVisible="{Binding TextoVazio, Converter={StaticResource TemTexto}}" />
            <Border Grid.Row="1" BackgroundColor="{StaticResource registro-fundo}" Stroke="{StaticResource sup-3}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18" Padding="0" IsVisible="{Binding Vazio, Converter={StaticResource Inverso}}">
                <CollectionView ItemsSource="{Binding Linhas}" Margin="14,4">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="telas:LinhaHistorico">
                            <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="8" Padding="0,8">
                                <Label Style="{StaticResource tipo-detalhe}" Text="{Binding Hora}" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Style="{StaticResource tipo-detalhe}" TextColor="{StaticResource texto}" Text="{Binding Frase}" />
                                    <Label Style="{StaticResource tipo-detalhe}" TextColor="{StaticResource erro-texto}" Text="{Binding Motivo}"
                                           IsVisible="{Binding Motivo, Converter={StaticResource TemTexto}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource tipo-rotulo}" Text="{Binding Origem}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Origem}" Value="IA">
                                            <Setter Property="TextColor" Value="{StaticResource ia}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
