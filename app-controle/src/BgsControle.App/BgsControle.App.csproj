<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Só Android. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BgsControle.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>BGS Controle</ApplicationTitle>
    <!-- Nada de applicationId nem marca da Taramps. -->
    <ApplicationId>br.com.bgs.controle</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- minSdk 26; o targetSdk fica no padrão do .NET 10. -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- APK que roda sozinho, sem o Fast Deployment, também no Debug. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#1F3A5F" />
    <!-- O splash no preto de palco (DESIGN, colors.palco), sem o azul antigo. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="128,128" />
  </ItemGroup>

  <!--
    História 10: no Debug o XAML é inflado em tempo de execução (o padrão do .NET 10), mas o XamlC também
    confere cada página (só validação, sem mexer no assembly). Assim um binding sem x:DataType, ou com um
    caminho que não existe, vira aviso já no build do Debug.
  -->
  <ItemGroup>
    <MauiXaml Update="**\*.xaml" Inflator="Runtime,XamlC" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgsControle.Nucleo\BgsControle.Nucleo.csproj" />
    <ProjectReference Include="..\BgsControle.Telas\BgsControle.Telas.csproj" />
  </ItemGroup>

</Project>
