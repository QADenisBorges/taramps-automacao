                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="CharacterSpacing" Value="0.8" />
            </Style>
            <Style x:Key="engrenagem" TargetType="Button" BasedOn="{StaticResource botao-base}">
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Text" Value="⚙" />
                <Setter Property="BackgroundColor" Value="{StaticResource sup-1}" />
                <Setter Property="TextColor" Value="{StaticResource texto}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="r:Tipo.Peso" Value="400" />
            </Style>

            <!-- Criação da memória (história 10d): button-flow-primary e button-flow-secondary (52 px, raio 14), os
                 botões da barra do fluxo (48 × 48) e o chip "+ Nova memória". -->
            <Style x:Key="botao-fluxo" TargetType="Button" BasedOn="{StaticResource botao-base}">
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="{StaticResource brand}" />
                <Setter Property="TextColor" Value="{StaticResource on-brand}" />
            </Style>
            <Style x:Key="botao-fluxo-secundario" TargetType="Button" BasedOn="{StaticResource botao-fluxo}">
                <Setter Property="BackgroundColor" Value="{StaticResource surface-2}" />
                <Setter Property="TextColor" Value="{StaticResource text-chip}" />
                <Setter Property="r:Tipo.Peso" Value="700" />
            </Style>
            <Style x:Key="botao-barra-fluxo" TargetType="Button" BasedOn="{StaticResource botao-base}">
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource text-chip}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="r:Tipo.Peso" Value="400" />
            </Style>
            <Style x:Key="chip-bgs" TargetType="Button" BasedOn="{StaticResource botao-base}">
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="BackgroundColor" Value="{StaticResource surface-2}" />
                <Setter Property="TextColor" Value="{StaticResource text-chip}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="r:Tipo.Peso" Value="600" />
            </Style>

            <!-- O Rendimento (história 13g; DESIGN, button-primary, button-secondary, button-outline e chip), com o alvo de
                 48 dp (EXPERIENCE, Accessibility Floor). -->
            <Style x:Key="chip-bgs-48" TargetType="Button" BasedOn="{StaticResource chip-bgs}">
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>
            <Style x:Key="botao-bgs" TargetType="Button" BasedOn="{StaticResource botao-base}">
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="r:Tipo.Peso" Value="700" />
                <Setter Property="BackgroundColor" Value="{StaticResource brand}" />
                <Setter Property="TextColor" Value="{StaticResource on-brand}" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="EstadosBgs">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource surface-2}" />
                                    <Setter Property="TextColor" Value="{StaticResource text-secondary}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="botao-bgs-secundario" TargetType="Button" BasedOn="{StaticResource botao-base}">
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="r:Tipo.Peso" Value="700" />
                <Setter Property="BackgroundColor" Value="{StaticResource white-07}" />
                <Setter Property="TextColor" Value="{StaticResource text-on-dark}" />
            </Style>
            <Style x:Key="botao-bgs-contorno" TargetType="Button" BasedOn="{StaticResource botao-base}">
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="r:Tipo.Peso" Value="600" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{StaticResource border-outline}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="{StaticResource text-secondary}" />
            </Style>
            <Style x:Key="cartao-bgs" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource surface-1}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="entrada-bgs" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource text-primary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource text-secondary}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="r:Tipo.Peso" Value="700" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- ============================================================ superfícies -->
            <Style x:Key="cartao" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource sup-1}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="cartao-grande" TargetType="Border" BasedOn="{StaticResource cartao}">
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="campo-numerico" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource campo}" />
                <Setter Property="Stroke" Value="{StaticResource campo-borda}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="MinimumWidthRequest" Value="112" />
                <Setter Property="Padding" Value="10,0" />
            </Style>
            <Style x:Key="entrada" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource campo}" />
                <Setter Property="TextColor" Value="{StaticResource texto}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource apagado}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="r:Tipo.Peso" Value="700" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style TargetType="ActivityIndicator">
                <Setter Property="Color" Value="{StaticResource apoio}" />
            </Style>
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource palco}" />
            </Style>
            <Style TargetType="NavigationPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource palco}" />
                <Setter Property="BarBackgroundColor" Value="{StaticResource palco}" />
                <Setter Property="BarTextColor" Value="{StaticResource texto}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
