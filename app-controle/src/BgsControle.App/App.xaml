<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Os tokens do DESIGN.md (ux-taramps-automacao-2026-10-21): cores pelos nomes dos tokens, a tipografia
    (estilos "tipo-…"; o peso real vem de r:Tipo.Peso, com o Roboto do sistema) e os componentes. Só tema
    escuro. As páginas usam só estes recursos, nunca cores soltas.
-->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:r="clr-namespace:BgsControle.App.Recursos"
             x:Class="BgsControle.App.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============================================================ cores (DESIGN, colors) -->
            <Color x:Key="palco">#000000</Color>
            <Color x:Key="sup-1">#1C1C1E</Color>
            <Color x:Key="sup-2">#2C2C2E</Color>
            <Color x:Key="sup-3">#232325</Color>
            <Color x:Key="lista-aberta">#151517</Color>
            <Color x:Key="registro-fundo">#0E0E10</Color>
            <Color x:Key="texto">#F5F5F7</Color>
            <Color x:Key="apoio">#A1A1A6</Color>
            <Color x:Key="apagado">#85858A</Color>
            <Color x:Key="sobre-escolhido">#000000</Color>
            <Color x:Key="sobre-escolhido-apoio">#55555A</Color>
            <!-- Uma luz por canal do processador; uma saída que é um par com link usa a do mestre. -->
            <Color x:Key="canal-1">#7EAEFF</Color>
            <Color x:Key="canal-2">#C495FF</Color>
            <Color x:Key="canal-3">#FFCD94</Color>
            <Color x:Key="canal-4">#8FE3CF</Color>
            <Color x:Key="ok">#30D158</Color>
            <Color x:Key="parar">#FF453A</Color>
            <Color x:Key="erro-texto">#FF8A82</Color>
            <Color x:Key="risco-fundo">#2A1414</Color>
            <!-- No MAUI a transparência vem antes: #AARRGGBB. -->
            <Color x:Key="risco-borda">#73FF453A</Color>
            <Color x:Key="veu">#A8000000</Color>
            <Color x:Key="capa-a">#3C3C41</Color>
            <Color x:Key="capa-b">#26262A</Color>
            <Color x:Key="capa-borda">#4C4C52</Color>
            <Color x:Key="campo">#0B0B0C</Color>
            <Color x:Key="campo-borda">#3A3A3D</Color>
            <!-- IA (história 11): o mesmo lilás do canal-2, por decisão do Denis. -->
            <Color x:Key="ia">#C495FF</Color>
            <Color x:Key="ia-fundo">#1B1526</Color>
            <Color x:Key="ia-texto">#D6C6F5</Color>
            <Color x:Key="ia-halo">#40C495FF</Color>

            <!-- Criação da memória (história 10d): os tokens do DESIGN.md do BGS Sound (30/10) que faltavam, pelos nomes
                 de lá. As transparências derivadas levam o nome do token e a opacidade. -->
            <Color x:Key="bg">#000000</Color>
            <Color x:Key="surface-1">#111114</Color>
            <Color x:Key="surface-2">#1C1C20</Color>
            <Color x:Key="surface-sheet">#141418</Color>
            <Color x:Key="border-sheet">#2A2A30</Color>
            <Color x:Key="text-primary">#F2F2F4</Color>
            <Color x:Key="text-chip">#CFCFD4</Color>
            <Color x:Key="text-secondary">#9A9AA2</Color>
            <Color x:Key="text-nav-inactive">#77777D</Color>
            <Color x:Key="brand">#3FD0FF</Color>
            <Color x:Key="on-brand">#00131A</Color>
            <Color x:Key="accent-pink">#FF2BD6</Color>
            <Color x:Key="connected">#34D399</Color>
            <Color x:Key="on-connected">#00140C</Color>
            <Color x:Key="overlay-glow">#0B2230</Color>
            <Color x:Key="stage-floor">#03070A</Color>
            <Color x:Key="channel-done">#16394A</Color>
            <Color x:Key="sheet-grab">#3A3A40</Color>
            <!-- Ciano a 12 % (resposta acesa), a 6 % (linha do refino), a 35 % (horizonte) e a 45 % (brilho). -->
            <Color x:Key="brand-12">#1F3FD0FF</Color>
            <Color x:Key="brand-06">#0F3FD0FF</Color>
            <Color x:Key="brand-35">#593FD0FF</Color>
            <Color x:Key="brand-45">#733FD0FF</Color>
            <!-- Preto a 90 % (o Aplicando sobre o palco) e branco a 8 % (a trilha do anel). -->
            <Color x:Key="scrim-aplicando">#E6000000</Color>
            <!-- Preto a 60 % (o véu atrás da folha, DESIGN sheet.scrim). -->
            <Color x:Key="scrim-sheet">#99000000</Color>
            <Color x:Key="ring-track">#14FFFFFF</Color>

            <!-- O Rendimento (história 13g): os tokens do DESIGN.md do BGS Sound que ainda faltavam, pelos nomes de lá, e as
                 transparências derivadas (o nome do token e a opacidade). -->
            <Color x:Key="warning">#FFB020</Color>
            <Color x:Key="text-on-dark">#FFFFFF</Color>
            <Color x:Key="text-status">#8A8A90</Color>
            <Color x:Key="divider">#1C1C20</Color>
            <!-- O fio do button-outline (DESIGN, components.button-outline). -->
            <Color x:Key="border-outline">#2A2A2E</Color>
            <!-- Branco a 7 % (button-secondary), ciano a 10 % (a pílula) e a 33 % (a borda da pílula). -->
            <Color x:Key="white-07">#12FFFFFF</Color>
            <Color x:Key="brand-10">#1A3FD0FF</Color>
            <Color x:Key="brand-33">#543FD0FF</Color>

            <!-- ============================================================ alvos de toque (DESIGN, spacing) -->
            <x:Double x:Key="alvo-min">44</x:Double>
            <x:Double x:Key="alvo-lista">52</x:Double>

            <!-- ============================================================ conversores -->
            <r:CorDaSaida x:Key="CorDaSaida" />
            <r:Inverso x:Key="Inverso" />
            <r:TemTexto x:Key="TemTexto" />
            <r:TamanhoDoNome x:Key="TamanhoDoNome" />

            <!-- ============================================================ tipografia (DESIGN, typography) -->
