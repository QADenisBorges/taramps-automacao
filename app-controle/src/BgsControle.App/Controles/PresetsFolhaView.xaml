<?xml version="1.0" encoding="utf-8" ?>
<!--
    A folha de presets do chip "Preset: Cinema ▾" (EXPERIENCE, Chip de preset; DESIGN, linha-de-escolha): uma
    linha por preset, o em uso em branco. Tocar aplica só as 15 bandas por cima da
    memória (sem confirmação, cópia antes, releitura) e fecha; travado, a folha fica com o motivo.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telas="clr-namespace:BgsControle.Telas;assembly=BgsControle.Telas"
             x:Class="BgsControle.App.Controles.PresetsFolhaView"
             x:DataType="telas:PresetsViewModel">
    <VerticalStackLayout Spacing="10">
        <Label Style="{StaticResource tipo-titulo-folha}" Text="{Binding TituloFolha}" />
        <Label Style="{StaticResource tipo-apoio}" Text="{Binding ApoioFolha}" />
        <Label Style="{StaticResource tipo-detalhe}" TextColor="{StaticResource texto}" Text="{Binding Mensagem}"
               IsVisible="{Binding Mensagem, Converter={StaticResource TemTexto}}" />
        <Border BackgroundColor="{StaticResource sup-1}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Itens}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="telas:ItemPresetViewModel">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,8" MinimumHeightRequest="52"
                                BackgroundColor="{StaticResource sup-2}" Margin="0,0,0,6">
                            <Grid>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding Nome}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding EmUso}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource sobre-escolhido}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding Detalhe}"
                                           IsVisible="{Binding Detalhe, Converter={StaticResource TemTexto}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding EmUso}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource sobre-escolhido-apoio}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding EmUso}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource texto}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Escolher}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
        <Button Style="{StaticResource botao-secundario}" Text="Fechar" Command="{Binding FecharFolha}" />
    </VerticalStackLayout>
</ContentView>
