+<?xml version="1.0" encoding="utf-8" ?>
+<!--
+    Configurações › Memórias (EXPERIENCE, Cartão de memória; DESIGN, cartao-de-memoria): as memórias do celular
+    do Setup em uso (EM USO, HERDADO, o preset lembrado; Aplicar, Renomear, Apagar), Criar memória do som atual
+    e a seção DO APARELHO, com as 3 do processador pelos nomes lidos e só Carregar.
+-->
+<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
+             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
+             xmlns:telas="clr-namespace:BgsControle.Telas;assembly=BgsControle.Telas"
+             xmlns:c="clr-namespace:BgsControle.App.Controles"
