+using System.Windows.Input;
+using BgsControle.Nucleo;
+using BgsControle.Nucleo.Escrita;
+
+namespace BgsControle.Telas;
+
+/// <summary>As três saídas da tela: JBL L (saída 1), JBL R (saída 2) e Sub (saídas 3 e 4).</summary>
+public enum Saida
+{
+    JblL = 0,
+    JblR = 1,
+    Sub = 2,
+}
+
+/// <summary>Os nomes e os canais das saídas, e os títulos dos parâmetros por extenso (EXPERIENCE, Voice and Tone).</summary>
+public static class Saidas
+{
+    public static IReadOnlyList<Saida> Todas { get; } = [Saida.JblL, Saida.JblR, Saida.Sub];
+
+    /// <summary>"JBL L", "JBL R" ou "Sub".</summary>
+    public static string Nome(Saida s) => s switch
+    {
+        Saida.JblL => "JBL L",
+        Saida.JblR => "JBL R",
+        _ => "Sub",
+    };
+
+    /// <summary>O canal no fio: JBL L = 0, JBL R = 1, Sub = 2 (a saída 4 segue pelo link 3–4).</summary>
+    public static int Canal(Saida s) => (int)s;
+
+    /// <summary>A saída de um canal no fio (0 a 3; o 3 é o Sub também), ou null para um global.</summary>
+    public static Saida? DoCanal(int? canal) => canal switch
+    {
+        0 => Saida.JblL,
+        1 => Saida.JblR,
+        2 or 3 => Saida.Sub,
+        _ => null,
+    };
+
+    /// <summary>"Saída 1", "Saída 2" ou, no Sub, "Saídas 3 e 4" (ou "Saídas 3+4 em ponte" com o link 3–4).</summary>
+    public static string Onde(Saida s, bool link34) => s switch
+    {
+        Saida.Sub => link34 ? "Saídas 3+4 em ponte" : "Saídas 3 e 4",
+        _ => $"Saída {Canal(s) + 1}",
+    };
+
+    /// <summary>A rota lida para a tela: "A", "B", "A+B" ou "—".</summary>
+    public static string Rota(EstadoAparelho estado, Saida s) =>
+        estado.Valor("010", Canal(s)) is { Rotulo: { } r } ? r : "—";
+
+    /// <summary>O nome por extenso de um parâmetro ("Passa-alta", "Atraso"), para o título do controle.</summary>
+    public static string Titulo(string codigo, int? indice = null) => codigo switch
+    {
+        "080" => "MASTER",
+        "081" => "Ganho",
+        "100" => "Mute",
+        "010" => "Rota",
+        "060" => "Fase",
+        "040" => "Passa-alta",
+        "041" => "Passa-baixa",
+        "042" => "Tipo do filtro",
+        "043" => "Tipo do filtro",
+        "050" => "Atraso",
+        "070" => "Auto do limitador",
+        "071" => "Limitador",
+        "072" => "Ataque",
+        "073" => "Liberação",
+        "090" => "Frequência",
+        "091" => "Ganho",
+        "092" => "Q",
+        "030" => "Ganho",
+        "031" => "Frequência",
+        "032" => "Q",
+        "020" => indice is { } b ? Catalogo.RotuloBanda(b) : "Banda",
+        "220" => "Preset de EQ do aparelho",
+        _ => Catalogo.ParametroDe(codigo)?.Nome ?? codigo,
+    };
+
+    /// <summary>Um número curto para os resumos ("+10,0", "80", "OFF"), ou "—" sem leitura.</summary>
+    public static string Curto(EstadoAparelho estado, string codigo, int? indice)
+    {
+        var p = Catalogo.ParametroDe(codigo);
+        if (p is null || estado.Valor(codigo, indice) is not { } v)
+            return "—";
+        if (v.Rotulo is not null)
+            return v.Rotulo;
+        if (v.Numero is not { } n)
+            return v.Exibicao;
+        if (p.Tipo == TipoValor.Hertz && n >= 1000)
+            return $"{(n / 1000m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',')}k";
+        return FormatoValor.Numero(p, n);
+    }
+}
+
+/// <summary>Um pedaço de um resumo, com a saída dona (a cor dela) ou null (texto de apoio).</summary>
+public sealed record TrechoResumo(string Texto, Saida? Saida = null);
+
+/// <summary>Um comando da tela com parâmetro (a opção escolhida, o valor do fader).</summary>
+public sealed class ComandoCom<T> : ICommand
+{
+    private readonly Func<T, Task> _acao;
+
+    public ComandoCom(Func<T, Task> acao) => _acao = acao;
+
+    public ComandoCom(Action<T> acao) : this(v =>
+    {
+        acao(v);
+        return Task.CompletedTask;
+    })
+    {
+    }
+
+    public event EventHandler? CanExecuteChanged
+    {
+        add { }
+        remove { }
+    }
+
+    public bool CanExecute(object? parameter) => true;
+
+    public async void Execute(object? parameter)
+    {
+        if (Converter(parameter, out var v))
+            await _acao(v);
+    }
+
+    /// <summary>Executa e espera o fim (testes).</summary>
+    public Task ExecutarAsync(T valor) => _acao(valor);
+
+    private static bool Converter(object? parameter, out T valor)
+    {
+        switch (parameter)
+        {
+            case T v:
+                valor = v;
+                return true;
+            case IConvertible c when typeof(T).IsPrimitive || typeof(T) == typeof(decimal):
+                valor = (T)Convert.ChangeType(c, typeof(T), System.Globalization.CultureInfo.InvariantCulture);
+                return true;
+            default:
+                valor = default!;
+                return false;
+        }
+    }
+}
