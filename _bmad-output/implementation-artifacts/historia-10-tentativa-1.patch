+    <ScrollView>
+        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" Padding="12,8,12,16"
+              BindableLayout.ItemsSource="{Binding Blocos}">
+            <BindableLayout.ItemTemplate>
+                <DataTemplate x:DataType="telas:BlocoFuncaoViewModel">
+                    <Border Grid.Row="{Binding Linha}" Grid.Column="{Binding Coluna}" Style="{StaticResource cartao}" Margin="4"
+                            Padding="12" MinimumHeightRequest="104">
+                        <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto" RowSpacing="6">
+                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource sup-2}" StrokeThickness="0"
+                                    StrokeShape="RoundRectangle 12" HorizontalOptions="Start">
+                                <Label Text="≋" TextColor="{StaticResource texto}" FontSize="20"
+                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
+                            </Border>
+                            <Label Grid.Column="1" Text="›" TextColor="{StaticResource apagado}" FontSize="20" VerticalTextAlignment="Center" />
+                            <Label Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource tipo-titulo-parametro}" Text="{Binding Titulo}">
