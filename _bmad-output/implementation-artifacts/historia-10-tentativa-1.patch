+++ b/app-controle/src/BgsControle.App/Recursos/Conversores.cs
@@ -0,0 +1,84 @@
+using System.Globalization;
+using BgsControle.Telas;
+
+namespace BgsControle.App.Recursos;
+
+/// <summary>Uma cor do dicionário do app pelo nome do token ("saida-l", "texto").</summary>
+public static class Cores
+{
+    public static Color De(string token) =>
+        Application.Current?.Resources.TryGetValue(token, out var v) == true && v is Color c ? c : Colors.Transparent;
+
+    /// <summary>A luz da saída: JBL L azul, JBL R lilás, Sub âmbar; sem saída, o branco do texto.</summary>
+    public static Color DaSaida(Saida? saida) => De(saida switch
+    {
+        Saida.JblL => "saida-l",
+        Saida.JblR => "saida-r",
+        Saida.Sub => "saida-sub",
+        _ => "texto",
+    });
+}
+
+/// <summary>
+/// <see cref="Saida"/> (ou null) → a cor da saída. O parâmetro "apoio" troca o null por {colors.apoio}
+/// (os trechos de texto dos resumos).
+/// </summary>
+public sealed class CorDaSaida : IValueConverter
+{
+    public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture)
+    {
+        var cor = value is Saida s
+            ? Cores.DaSaida(s)
+            : parameter as string is { Length: > 0 } token ? Cores.De(token) : Cores.DaSaida(null);
+        return typeof(Brush).IsAssignableFrom(targetType) ? new SolidColorBrush(cor) : cor;
+    }
+
+    public object? ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) => throw new NotSupportedException();
+}
+
+/// <summary>bool → o contrário.</summary>
+public sealed class Inverso : IValueConverter
+{
+    public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture) => value is not true;
+
+    public object? ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) => value is not true;
+}
+
+/// <summary>Texto (ou qualquer coisa) → visível quando não é nulo nem vazio.</summary>
+public sealed class TemTexto : IValueConverter
+{
+    public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture) => value switch
+    {
+        null => false,
+        string s => s.Length > 0,
+        System.Collections.ICollection c => c.Count > 0,
+        _ => true,
+    };
+
+    public object? ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) => throw new NotSupportedException();
+}
+
+/// <summary>
+/// O nome da memória em uso (DESIGN, cartão da memória em uso): 60 px; um nome longo diminui até os
+/// 36 px da lista e depois quebra em duas linhas; nunca corta.
+/// </summary>
+public sealed class TamanhoDoNome : IValueConverter
+{
+    public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+        (value as string)?.Length switch
+        {
+            null or <= 8 => 60d,
+            <= 10 => 46d,
+            _ => 36d,
+        };
+
+    public object? ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) => throw new NotSupportedException();
+}
+
+/// <summary><see cref="Saida"/> → a coluna dela numa grade de três (JBL L, JBL R, Sub).</summary>
+public sealed class Coluna : IValueConverter
+{
+    public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture) => value is Saida s ? (int)s : 0;
+
+    public object? ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) => throw new NotSupportedException();
+}
