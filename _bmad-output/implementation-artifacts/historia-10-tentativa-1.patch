+        <Grid RowDefinitions="Auto,*">
+            <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="16,8">
+                <Button Style="{StaticResource botao-voltar}" Clicked="AoVoltar" />
+                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
+                    <Label Style="{StaticResource tipo-titulo-tela}" Text="Memórias" />
+                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding TituloCelular}" />
+                </VerticalStackLayout>
+            </Grid>
+            <ScrollView Grid.Row="1">
+                <VerticalStackLayout Padding="16,8" Spacing="10">
+                    <Label Style="{StaticResource tipo-detalhe}" TextColor="{StaticResource texto}" Text="{Binding Mensagem}"
+                           IsVisible="{Binding Mensagem, Converter={StaticResource TemTexto}}" />
+                    <Label Style="{StaticResource tipo-apoio}" Text="{Binding MotivoTravaCelular}"
+                           IsVisible="{Binding MotivoTravaCelular, Converter={StaticResource TemTexto}}" />
+
+                    <!-- Som diferente da memória ativa. -->
+                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
+                          IsVisible="{Binding AvisoSomDiferente, Converter={StaticResource TemTexto}}">
+                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource apoio}" VerticalOptions="Center" />
+                        <Label Grid.Column="1" Style="{StaticResource tipo-detalhe}" TextColor="{StaticResource texto}"
+                               Text="{Binding AvisoSomDiferente}" VerticalTextAlignment="Center" />
+                        <Button Grid.Column="2" Style="{StaticResource botao-pequeno}" Text="Reaplicar" Command="{Binding Reaplicar}" />
+                    </Grid>
+
+                    <!-- As memórias do celular. -->
+                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Cartoes}">
+                        <BindableLayout.ItemTemplate>
+                            <DataTemplate x:DataType="telas:CartaoMemoriaCelularViewModel">
+                                <Border Style="{StaticResource cartao-grande}">
+                                    <VerticalStackLayout Spacing="8">
+                                        <HorizontalStackLayout Spacing="8">
+                                            <Border IsVisible="{Binding EmUso}" BackgroundColor="{StaticResource texto}" StrokeThickness="0"
+                                                    StrokeShape="RoundRectangle 11" HeightRequest="22" Padding="8,0">
+                                                <Label Style="{StaticResource tipo-rotulo}" TextColor="{StaticResource sobre-escolhido}"
+                                                       Text="{Binding SeloEmUso}" VerticalTextAlignment="Center" />
+                                            </Border>
+                                            <Border IsVisible="{Binding Herdado}" Stroke="{StaticResource campo-borda}" StrokeThickness="1"
+                                                    StrokeShape="RoundRectangle 11" HeightRequest="22" Padding="8,0">
+                                                <Label Style="{StaticResource tipo-rotulo}" TextColor="{StaticResource apoio}" Text="{Binding Selo}"
+                                                       VerticalTextAlignment="Center" />
+                                                <Border.GestureRecognizers>
+                                                    <TapGestureRecognizer Command="{Binding AlternarNota}" />
+                                                </Border.GestureRecognizers>
+                                            </Border>
+                                        </HorizontalStackLayout>
+                                        <Label Style="{StaticResource tipo-memoria-lista}" Text="{Binding Nome}" />
+                                        <Label Style="{StaticResource tipo-detalhe}" Text="{Binding TextoPreset}"
+                                               IsVisible="{Binding TextoPreset, Converter={StaticResource TemTexto}}" />
+                                        <Label Style="{StaticResource tipo-apoio}" Text="{Binding Nota}" IsVisible="{Binding NotaVisivel}" />
+                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
+                                            <Button Style="{StaticResource botao-pequeno}" Text="Aplicar" Command="{Binding Aplicar}" />
+                                            <Button Grid.Column="1" Style="{StaticResource botao-contornado-pequeno}" Text="Renomear" Command="{Binding Renomear}" />
+                                            <Button Grid.Column="2" Style="{StaticResource botao-contornado-pequeno}" Text="Apagar" Command="{Binding Apagar}">
+                                                <Button.Triggers>
+                                                    <DataTrigger TargetType="Button" Binding="{Binding EmUso}" Value="True">
+                                                        <Setter Property="TextColor" Value="{StaticResource apagado}" />
+                                                        <Setter Property="BorderColor" Value="Transparent" />
+                                                    </DataTrigger>
+                                                </Button.Triggers>
+                                            </Button>
+                                        </Grid>
+                                    </VerticalStackLayout>
+                                </Border>
+                            </DataTemplate>
+                        </BindableLayout.ItemTemplate>
+                    </VerticalStackLayout>
+                    <Label Style="{StaticResource tipo-apoio}" Text="{Binding TextoVazio}"
+                           IsVisible="{Binding TextoVazio, Converter={StaticResource TemTexto}}" />
+                    <Button Style="{StaticResource botao-secundario}" Text="{x:Static telas:MemoriasViewModel.TextoCriar}"
+                            Command="{Binding AbrirCriar}" />
+                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaCriar}"
+                           IsVisible="{Binding MotivoTravaCriar, Converter={StaticResource TemTexto}}" />
+
+                    <!-- Do aparelho: só Carregar. -->
+                    <Label Style="{StaticResource tipo-rotulo}" Text="DO APARELHO" Margin="0,10,0,0" />
+                    <Label Style="{StaticResource tipo-detalhe}" Text="{x:Static telas:MemoriasViewModel.LembreteAparelho}" />
+                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding DoAparelho}">
+                        <BindableLayout.ItemTemplate>
+                            <DataTemplate x:DataType="telas:CartaoMemoriaAparelhoViewModel">
+                                <Border Style="{StaticResource cartao-grande}">
+                                    <VerticalStackLayout Spacing="6">
+                                        <Label Style="{StaticResource tipo-rotulo}" Text="{Binding Titulo}" />
+                                        <Label Style="{StaticResource tipo-memoria-lista}" Text="{Binding Nome}" />
+                                        <Label Style="{StaticResource tipo-apoio}" Text="{Binding NotaHerdada}" IsVisible="{Binding NotaVisivel}" />
+                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
+                                            <Button Style="{StaticResource botao-pequeno}" Text="Carregar" Command="{Binding Carregar}" />
+                                            <Button Grid.Column="1" Style="{StaticResource botao-contornado-pequeno}" Text="Nota"
