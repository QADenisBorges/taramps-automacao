+            <!-- Sem conexão: o cartão de conexão. -->
+            <Border Style="{StaticResource cartao-grande}" IsVisible="{Binding MostrarConexao}">
+                <VerticalStackLayout Spacing="10">
+                    <Label Style="{StaticResource tipo-rotulo}" Text="PROCESSADOR" />
+                    <Label Style="{StaticResource tipo-estado-hero}" Text="{Binding EstadoConexao}" />
+                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding HoraQueCaiu}"
+                           IsVisible="{Binding HoraQueCaiu, Converter={StaticResource TemTexto}}" />
+                    <Label Style="{StaticResource tipo-apoio}" Text="{Binding FraseConexao}" />
+                    <ActivityIndicator IsRunning="{Binding Conexao.Ocupado}" IsVisible="{Binding Conexao.Ocupado}"
+                                       HorizontalOptions="Start" HeightRequest="28" />
+
+                    <!-- As caixas da senha: um campo escondido por cima das 4 caixas; cada caractere vira •. -->
+                    <VerticalStackLayout Spacing="10" IsVisible="{Binding Conexao.PedindoSenha}">
+                        <Grid HeightRequest="64">
+                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start"
+                                                   BindableLayout.ItemsSource="{Binding Conexao.Caixas}">
+                                <BindableLayout.ItemTemplate>
+                                    <DataTemplate x:DataType="telas:CaixaSenha">
+                                        <Border WidthRequest="56" HeightRequest="64" BackgroundColor="{StaticResource campo}"
+                                                StrokeShape="RoundRectangle 14" StrokeThickness="0">
+                                            <Grid>
+                                                <Label Style="{StaticResource tipo-valor-canal}" Text="{Binding Texto}"
+                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
+                                                <BoxView HeightRequest="2" VerticalOptions="End" Margin="10,0,10,8"
+                                                         Color="{StaticResource apagado}" />
+                                            </Grid>
+                                            <Border.Triggers>
+                                                <DataTrigger TargetType="Border" Binding="{Binding Atual}" Value="True">
+                                                    <Setter Property="Stroke" Value="{StaticResource texto}" />
+                                                    <Setter Property="StrokeThickness" Value="2" />
+                                                </DataTrigger>
+                                            </Border.Triggers>
+                                        </Border>
+                                    </DataTemplate>
+                                </BindableLayout.ItemTemplate>
+                            </HorizontalStackLayout>
+                            <Entry x:Name="CampoSenha" Opacity="0.02" Text="{Binding Conexao.SenhaDigitada}"
+                                   IsPassword="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
+                                   MaxLength="4" ReturnType="Send" ReturnCommand="{Binding Conexao.EnviarSenha}"
+                                   Completed="AoEnviarSenha" />
+                        </Grid>
+                        <Button Style="{StaticResource botao-principal}" Text="Enviar a senha"
+                                Command="{Binding Conexao.EnviarSenha}" Clicked="AoEnviarSenha" />
+                    </VerticalStackLayout>
+
+                    <Button Style="{StaticResource botao-principal}" Text="Conectar" Command="{Binding Conexao.Conectar}"
+                            IsVisible="{Binding Conexao.PodeConectar}" />
+                    <Button Style="{StaticResource botao-secundario}" Text="{Binding Conexao.TextoDesconectar}"
+                            Command="{Binding Conexao.Desconectar}" IsVisible="{Binding Conexao.PodeDesconectar}" />
+                </VerticalStackLayout>
+            </Border>
+
+            <!-- Conectado e lendo: a contagem. -->
+            <HorizontalStackLayout Spacing="8" IsVisible="{Binding TextoLendo, Converter={StaticResource TemTexto}}">
+                <ActivityIndicator IsRunning="True" HeightRequest="20" WidthRequest="20" />
+                <Label Style="{StaticResource tipo-apoio}" Text="{Binding TextoLendo}" VerticalTextAlignment="Center" />
+            </HorizontalStackLayout>
+
+            <!-- O cartão da memória em uso. -->
+            <Border Style="{StaticResource cartao-grande}" IsVisible="{Binding MostrarMemoria}">
+                <Grid>
+                    <c:ArcoView WidthRequest="180" HeightRequest="180" HorizontalOptions="End" VerticalOptions="Start"
+                                Margin="0,-90,-90,0" />
+                    <VerticalStackLayout Spacing="10">
+                        <Label Style="{StaticResource tipo-rotulo}" Text="MEMÓRIA EM USO" />
+                        <Label Style="{StaticResource tipo-memoria-hero}" Text="{Binding NomeMemoria}"
+                               FontSize="{Binding NomeMemoria, Converter={StaticResource TamanhoDoNome}}" />
+                        <Label Style="{StaticResource tipo-apoio}" Text="{Binding LinhaMemoria}"
+                               IsVisible="{Binding LinhaMemoria, Converter={StaticResource TemTexto}}" />
