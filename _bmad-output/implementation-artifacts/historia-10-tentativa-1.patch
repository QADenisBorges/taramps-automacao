+                        <Button Style="{StaticResource botao-medio}" Text="Criar memória do som atual"
+                                Command="{Binding CriarMemoria}" IsVisible="{Binding MostrarCriarMemoria}" />
+
+                        <c:BotoesMemoriaView BindingContext="{Binding Memorias}" />
+                    </VerticalStackLayout>
+                </Grid>
+            </Border>
