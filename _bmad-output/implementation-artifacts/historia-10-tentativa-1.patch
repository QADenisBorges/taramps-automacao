+                                </Border>
+                            </DataTemplate>
+                        </BindableLayout.ItemTemplate>
+                    </VerticalStackLayout>
+                    <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTravaCarregar}"
+                           IsVisible="{Binding MotivoTravaCarregar, Converter={StaticResource TemTexto}}" />
+                </VerticalStackLayout>
+            </ScrollView>
+        </Grid>
+
+        <!-- Criar memória do som atual: o nome. -->
+        <c:FolhaView Aberta="{Binding CriarAberto}" Fechar="{Binding CancelarCriar}">
+            <VerticalStackLayout Spacing="10">
+                <Label Style="{StaticResource tipo-titulo-folha}" Text="{x:Static telas:MemoriasViewModel.TextoCriar}" />
+                <Label Style="{StaticResource tipo-corpo}" TextColor="{StaticResource apoio}"
+                       Text="A memória nova guarda o caráter que está tocando e vira a memória em uso." />
+                <Entry Style="{StaticResource entrada}" Text="{Binding NomeNova}" MaxLength="24" Placeholder="MUSICA ORIG"
+                       ReturnType="Done" ReturnCommand="{Binding ConfirmarCriar}" />
+                <Label Style="{StaticResource tipo-texto-erro}" Text="{Binding ErroNova}"
+                       IsVisible="{Binding ErroNova, Converter={StaticResource TemTexto}}" />
+                <Button Style="{StaticResource botao-principal}" Text="Criar a memória" Command="{Binding ConfirmarCriar}" />
+                <Button Style="{StaticResource botao-secundario}" Text="Cancelar" Command="{Binding CancelarCriar}" />
+            </VerticalStackLayout>
+        </c:FolhaView>
+
+        <!-- Renomear. -->
+        <c:FolhaView Aberta="{Binding RenomearAberto}" Fechar="{Binding CancelarRenomear}">
+            <VerticalStackLayout Spacing="10">
+                <Label Style="{StaticResource tipo-titulo-folha}" Text="{Binding RenomearTitulo}" />
+                <Entry Style="{StaticResource entrada}" Text="{Binding NomeRenomear}" MaxLength="24"
+                       ReturnType="Done" ReturnCommand="{Binding ConfirmarRenomear}" />
+                <Label Style="{StaticResource tipo-texto-erro}" Text="{Binding ErroRenomear}"
+                       IsVisible="{Binding ErroRenomear, Converter={StaticResource TemTexto}}" />
+                <Button Style="{StaticResource botao-principal}" Text="Renomear" Command="{Binding ConfirmarRenomear}" />
+                <Button Style="{StaticResource botao-secundario}" Text="Cancelar" Command="{Binding CancelarRenomear}" />
+            </VerticalStackLayout>
+        </c:FolhaView>
+
+        <!-- Apagar. -->
+        <c:FolhaView Aberta="{Binding ApagarAberto}" Fechar="{Binding CancelarApagar}">
+            <VerticalStackLayout Spacing="10">
+                <Label Style="{StaticResource tipo-titulo-folha}" Text="{Binding ApagarTitulo}" />
+                <Label Style="{StaticResource tipo-corpo}" Text="{Binding ApagarAviso}" />
+                <Button Style="{StaticResource botao-principal}" Text="Apagar a memória" Command="{Binding ConfirmarApagar}" />
+                <Button Style="{StaticResource botao-secundario}" Text="Cancelar" Command="{Binding CancelarApagar}" />
+            </VerticalStackLayout>
+        </c:FolhaView>
+
+        <!-- A folha do Salvar (Criar memória com o som do aparelho em uso). -->
+        <c:SalvarFolhaView x:Name="FolhaSalvar" />
+    </Grid>
+</ContentPage>
diff --git a/app-controle/src/BgsControle.App/Telas/MemoriasPage.xaml.cs b/app-controle/src/BgsControle.App/Telas/MemoriasPage.xaml.cs
new file mode 100644
index 0000000..6a43408
--- /dev/null
+++ b/app-controle/src/BgsControle.App/Telas/MemoriasPage.xaml.cs
@@ -0,0 +1,37 @@
+using BgsControle.Telas;
+
+namespace BgsControle.App.Telas;
+
+/// <summary>Navegação: ‹ e o Voltar do Android (que fecha a folha aberta antes).</summary>
+public partial class MemoriasPage : ContentPage
+{
+    private readonly MemoriasViewModel _vm;
+    private readonly SalvarViewModel _salvar;
+
+    public MemoriasPage(MemoriasViewModel vm, SalvarViewModel salvar)
+    {
+        InitializeComponent();
+        _vm = vm;
+        _salvar = salvar;
+        // Antes da página: a folha do Salvar não herda a tela Memórias nem por um instante.
+        FolhaSalvar.BindingContext = salvar;
+        BindingContext = vm;
+    }
+
+    private void AoVoltar(object? sender, EventArgs e) => _ = Navigation.PopAsync();
+
+    protected override bool OnBackButtonPressed()
+    {
+        if (_salvar.Aberta)
+            _salvar.Cancelar.Execute(null);
+        else if (_vm.CriarAberto)
+            _vm.CancelarCriar.Execute(null);
+        else if (_vm.RenomearAberto)
+            _vm.CancelarRenomear.Execute(null);
+        else if (_vm.ApagarAberto)
+            _vm.CancelarApagar.Execute(null);
+        else
+            return base.OnBackButtonPressed();
+        return true;
+    }
+}
diff --git a/app-controle/src/BgsControle.App/Telas/MesaView.xaml b/app-controle/src/BgsControle.App/Telas/MesaView.xaml
new file mode 100644
index 0000000..9f2ea8f
--- /dev/null
+++ b/app-controle/src/BgsControle.App/Telas/MesaView.xaml
@@ -0,0 +1,93 @@
+<?xml version="1.0" encoding="utf-8" ?>
+<!--
+    A Mesa (DESIGN, Layout › Mesa; canal-da-mesa, master): no topo, MEMÓRIA EM USO e os mesmos botões de
+    memória do Início; três canais em colunas iguais (nome na cor, campo do ganho, fader vertical, resumo,
+    Ajustar) e o MASTER embaixo. A faixa de monitoração e os chips são da próxima versão.
+-->
+<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
+             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
+             xmlns:telas="clr-namespace:BgsControle.Telas;assembly=BgsControle.Telas"
+             xmlns:c="clr-namespace:BgsControle.App.Controles"
+             x:Class="BgsControle.App.Telas.MesaView"
+             x:DataType="telas:MesaViewModel">
+    <Grid RowDefinitions="Auto,*,Auto" Padding="16,8,16,12" RowSpacing="12">
+
+        <VerticalStackLayout Spacing="6">
+            <HorizontalStackLayout Spacing="8">
+                <Label Style="{StaticResource tipo-rotulo}" Text="{Binding RotuloMemoria}" VerticalTextAlignment="Center" />
+                <Label Style="{StaticResource tipo-linha-titulo}" Text="{Binding NomeMemoria}" VerticalTextAlignment="Center" />
+            </HorizontalStackLayout>
+            <c:BotoesMemoriaView BindingContext="{Binding Memorias}" />
+        </VerticalStackLayout>
+
+        <!-- Os três canais. -->
+        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" BindableLayout.ItemsSource="{Binding Canais}">
+            <BindableLayout.ItemTemplate>
+                <DataTemplate x:DataType="telas:CanalMesaViewModel">
+                    <Border BackgroundColor="{StaticResource sup-1}" StrokeThickness="0" StrokeShape="RoundRectangle 22"
+                            Grid.Column="{Binding Saida, Converter={StaticResource Coluna}}">
+                        <Grid RowDefinitions="4,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="6">
+                            <BoxView Color="{Binding Saida, Converter={StaticResource CorDaSaida}}" />
+                            <VerticalStackLayout Grid.Row="1" Padding="8,8,8,0" Spacing="2">
+                                <Label Style="{StaticResource tipo-nome-canal}" Text="{Binding Nome}" HorizontalTextAlignment="Center"
+                                       TextColor="{Binding Saida, Converter={StaticResource CorDaSaida}}" />
+                                <Label Style="{StaticResource tipo-escala}" Text="{Binding Subtitulo}" HorizontalTextAlignment="Center" />
+                            </VerticalStackLayout>
+                            <!-- O campo do ganho: tocar no número vira campo. -->
+                            <Border Grid.Row="2" Style="{StaticResource campo-numerico}" Margin="6,0" MinimumWidthRequest="0"
+                                    BindingContext="{Binding Ganho}">
+                                <Grid x:DataType="telas:ControleParametroViewModel">
+                                    <Label Style="{StaticResource tipo-valor-canal}" FontSize="20" Text="{Binding TextoValor}"
+                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
+                                    <BoxView HeightRequest="2" VerticalOptions="End" Margin="-10,0"
+                                             Color="{Binding Saida, Converter={StaticResource CorDaSaida}}" />
+                                    <Grid.GestureRecognizers>
+                                        <TapGestureRecognizer Command="{Binding TocarNoValor}" />
+                                    </Grid.GestureRecognizers>
+                                </Grid>
+                            </Border>
+                            <c:CampoEdicaoView Grid.Row="3" Margin="6,0" BindingContext="{Binding Ganho}" />
+                            <ContentView Grid.Row="4" BindingContext="{Binding Ganho}">
+                                <c:FaderView x:DataType="telas:ControleParametroViewModel" Vertical="True" MinimumHeightRequest="160"
+                                             Minimo="{Binding Minimo}" Maximo="{Binding Maximo}" Valor="{Binding ValorFader}"
+                                             Travado="{Binding Travado}" Cor="{Binding Saida, Converter={StaticResource CorDaSaida}}"
+                                             ComandoArrastar="{Binding ArrastarPara}" ComandoSoltar="{Binding SoltarFader}" />
+                            </ContentView>
+                            <Label Grid.Row="5" Style="{StaticResource tipo-escala}" Text="{Binding Resumo}" Margin="6,0"
+                                   HorizontalTextAlignment="Center" />
+                            <Button Grid.Row="6" Style="{StaticResource botao-pequeno}" Text="Ajustar" Margin="8,0,8,8"
+                                    TextColor="{Binding Saida, Converter={StaticResource CorDaSaida}}" Command="{Binding Ajustar}" />
+                        </Grid>
+                    </Border>
+                </DataTemplate>
+            </BindableLayout.ItemTemplate>
+        </Grid>
+
+        <!-- O MASTER: todas as saídas, −80,0 a 0,0 dB. -->
+        <Border Grid.Row="2" BackgroundColor="{StaticResource sup-1}" StrokeThickness="0" StrokeShape="RoundRectangle 22"
+                Padding="14,8" BindingContext="{Binding Master}">
+            <VerticalStackLayout x:DataType="telas:ControleParametroViewModel" Spacing="4">
+                <Grid ColumnDefinitions="*,*,100" ColumnSpacing="10" MinimumHeightRequest="60">
+                    <Label Style="{StaticResource tipo-nome-canal}" Text="MASTER" VerticalTextAlignment="Center" />
+                    <c:FaderView Grid.Column="1" HeightRequest="44" Minimo="{Binding Minimo}" Maximo="{Binding Maximo}"
+                                 Valor="{Binding ValorFader}" Travado="{Binding Travado}"
+                                 ComandoArrastar="{Binding ArrastarPara}" ComandoSoltar="{Binding SoltarFader}" />
+                    <Border Grid.Column="2" Style="{StaticResource campo-numerico}" MinimumWidthRequest="100">
+                        <Grid>
+                            <Label Style="{StaticResource tipo-valor-campo}" FontSize="18" Text="{Binding TextoValor}"
+                                   HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
+                            <BoxView HeightRequest="2" VerticalOptions="End" Margin="-10,0" Color="{StaticResource texto}" />
+                        </Grid>
+                        <Border.GestureRecognizers>
+                            <TapGestureRecognizer Command="{Binding TocarNoValor}" />
+                        </Border.GestureRecognizers>
+                    </Border>
+                </Grid>
+                <Label Style="{StaticResource tipo-escala}" Text="todas as saídas · −80 · −40 · 0" />
+                <c:CampoEdicaoView />
+                <Label Style="{StaticResource tipo-detalhe}" Text="{Binding MotivoTrava}"
+                       IsVisible="{Binding MotivoTrava, Converter={StaticResource TemTexto}}" />
+            </VerticalStackLayout>
+        </Border>
+    </Grid>
+</ContentView>
