+<?xml version="1.0" encoding="utf-8" ?>
+<!--
+    A grade Áudio (DESIGN, bloco-de-funcao; Layout › Grade Áudio): 2 × 5, na ordem do app da Taramps. Cada
+    bloco tem o ícone, o nome, o resumo do valor atual com os números na cor de cada saída e ›. O Gerador fica
+    travado até a próxima versão.
+-->
+<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
+             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
+             xmlns:telas="clr-namespace:BgsControle.Telas;assembly=BgsControle.Telas"
