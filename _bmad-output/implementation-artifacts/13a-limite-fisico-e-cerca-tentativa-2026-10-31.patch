+using BgsControle.Nucleo.Escrita;
+using BgsControle.Nucleo.Setups;
+
+namespace BgsControle.Nucleo.Rendimento;
+
+/// <summary>
+/// A cerca do limitador (spec-rendimento CAP-2, história 13a): uma escrita que deixe uma saída calibrada
+/// e com limite com o limitador OFF ou com o limiar acima do teto é recusada antes de qualquer envio. Ela
+/// confere o estado como ficaria depois da escrita (o espelho com a escrita, ou o lote inteiro, por cima)
+/// em toda saída que a escrita toca: as escritas do limitador (<c>071</c>) e do passa-alta (<c>040</c> e
+/// <c>042</c>, que mudam o X). Sem nível em uso, o teto é min(T, X, C) (os níveis são da 13c). Não tem
+/// chave nem exceção. É ligada no <see cref="Escritor"/> pelo <see cref="GerenteSetups"/>, como o bloqueio
+/// da cópia antes.
+/// </summary>
+public static class Cerca
+{
+    public const string CodigoLimitador = "071";
+    public const string CodigoPassaAlta = "040";
+    public const string CodigoFiltroPassaAlta = "042";
+
+    /// <summary>O OFF do limitador no fio (<c>071</c> = 0,5).</summary>
+    public const decimal LimitadorOff = 0.5m;
+
+    public const string MsgFalhou = "Não consegui conferir o limite da saída. Nada foi enviado.";
+
+    /// <summary>"Limite da JBL L: −6,8 dB, pelo térmico."</summary>
+    public static string MsgLimite(string saida, decimal teto, TipoLimite manda) =>
+        $"Limite da {saida}: {LimiteFisico.Db(teto)} dB, pelo {LimiteFisico.NomeLimite(manda)}.";
+
+    /// <summary>"Limite da JBL L: o limitador não pode ficar desligado."</summary>
+    public static string MsgOff(string saida) => $"Limite da {saida}: o limitador não pode ficar desligado.";
+
+    /// <summary>A escrita deste código toca o limite de uma saída: o limitador, o passa-alta e o tipo dele.</summary>
+    public static bool Toca(string codigo) => codigo is CodigoLimitador or CodigoPassaAlta or CodigoFiltroPassaAlta;
+
+    /// <summary>
+    /// Confere as escritas (uma, com a cópia do link, ou um lote inteiro) contra o estado como ficaria
+    /// depois delas. Devolve a mensagem da primeira saída recusada, ou null. Sem equipamentos (sem Setup em
+    /// uso), ou sem escrita que toque um limite, passa.
+    /// </summary>
+    /// <param name="equipamentos">Os equipamentos do Setup, ou null.</param>
+    /// <param name="saidas">As saídas do app (o link que vale).</param>
+    /// <param name="espelho">O estado do aparelho agora.</param>
+    /// <param name="escritas">O que vai ser escrito, na ordem (o último valor de um endereço vale).</param>
+    public static string? Conferir(IReadOnlyList<Equipamento>? equipamentos, IReadOnlyList<SaidaApp> saidas,
+        IReadOnlyDictionary<Endereco, Valor> espelho, IEnumerable<(Endereco Endereco, Valor Valor)> escritas)
+    {
+        var lista = escritas.ToArray();
+        var canais = lista
+            .Where(e => Toca(e.Endereco.Codigo) && e.Endereco.Indice is not null)
+            .Select(e => e.Endereco.Indice!.Value)
+            .ToHashSet();
+        if (canais.Count == 0 || equipamentos is null || equipamentos.Count == 0)
+            return null;
+
+        var depois = new Dictionary<Endereco, Valor>(espelho);
+        foreach (var (endereco, valor) in lista)
+            depois[endereco] = valor;
+        Valor? Ler(Endereco e) => depois.GetValueOrDefault(e);
+
+        var nomes = Ligacoes.NomesNaTela(saidas);
+        for (var i = 0; i < saidas.Count; i++)
+        {
+            var saida = saidas[i];
+            if (!saida.Canais.Any(canais.Contains))
+                continue;
+            var limite = LimiteFisico.CalcularSaida(equipamentos, saida, nomes[i], Ler);
+            if (Recusa(limite, Ler) is { } motivo)
+                return motivo;
+        }
+        return null;
+    }
+
+    /// <summary>A recusa da saída no estado dado (limitador OFF ou acima do teto em algum canal dela), ou null.</summary>
+    public static string? Recusa(LimiteSaida limite, Func<Endereco, Valor?> ler)
+    {
+        if (!limite.Cercada || limite.TetoDb is not { } teto || limite.Manda is not { } manda)
+            return null;
+        foreach (var canal in limite.Canais)
+        {
+            if (ler(new Endereco(CodigoLimitador, canal))?.Numero is not { } limiar)
+                continue;
+            if (limiar == LimitadorOff)
+                return MsgOff(limite.Nome);
+            if (limiar > teto)
+                return MsgLimite(limite.Nome, teto, manda);
+        }
+        return null;
+    }
+}
diff --git a/app-controle/src/BgsControle.Nucleo/Rendimento/LimiteFisico.cs b/app-controle/src/BgsControle.Nucleo/Rendimento/LimiteFisico.cs
