+    private static IReadOnlyList<Equipamento> Casa(DadosTecnicos? jbl = null, DadosTecnicos? sub = null, DadosTecnicos? modulo = null) =>
+        CasaDoDenis.EquipamentosCasa.Select(e => e.Id switch
+        {
